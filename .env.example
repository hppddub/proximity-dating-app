# Node 24 required. Set variables in your shell or use Node --env-file with tsx.
HOST=127.0.0.1
PORT=8787
DB_PATH=data/prototype.sqlite
DEMO_MODE=false
# Remote push is optional to run the server. Without these, jobs are explicitly
# unconfigured, not delivered. Never commit the credential files.
# FCM_SERVICE_ACCOUNT_FILE=/absolute/private/service-account.json
# FIREBASE_APP_ID=Android Firebase application ID
# FIREBASE_API_KEY=Firebase client API key (restrict in project)
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_SENDER_ID=your-sender-id
# APNS_KEY_FILE=/absolute/private/AuthKey.p8
# APNS_KEY_ID=your-key-id
# APNS_TEAM_ID=your-team-id
# APNS_TOPIC=ca.proximity.lab
# APNS_PRODUCTION=false
